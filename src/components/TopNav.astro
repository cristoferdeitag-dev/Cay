---
const links = [
  { href: '#inicio', label: 'Inicio', active: true },
  { href: '#que-es', label: 'Acuaponía' },
  { href: '#granjas', label: 'Granjas' },
  { href: '#productos', label: 'Productos' },
  { href: '#sobre', label: 'Sobre CAY' },
  { href: '#blog', label: 'Blog' },
  { href: '#encuentranos', label: 'Encuéntranos' },
];
---

<nav class="fixed top-0 w-full z-50 bg-surface/95 backdrop-blur-sm border-b border-primary/10">
  <div class="flex justify-between items-center px-6 py-3 max-w-[1200px] mx-auto">
    <a class="flex items-center gap-2 font-headline text-2xl font-bold text-secondary" href="/">
      <img alt="CAY Logo" class="h-12 w-12 object-contain" src="/images/cay-logo.png" />
      <span>CAY</span>
    </a>

    <div class="hidden lg:flex gap-5 xl:gap-7 items-center font-body text-sm">
      {
        links.map((link) => (
          <a
            class={
              link.active
                ? 'text-primary font-bold border-b-2 border-primary pb-1 hover:text-primary transition-colors duration-200'
                : 'text-onSurface font-medium hover:text-primary transition-colors duration-200'
            }
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="hidden md:inline-flex bg-primary text-white px-5 py-2 rounded-full font-medium text-sm hover:bg-primary/90 active:scale-95 transition-all"
      >
        Contáctanos
      </a>

      <button class="lg:hidden text-onSurface" aria-label="Abrir menú">
        <span class="material-symbols-outlined text-3xl">menu</span>
      </button>
    </div>
  </div>
</nav>
