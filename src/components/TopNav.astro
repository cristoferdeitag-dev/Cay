---
const links = [
  { href: '#que-es', label: 'Acuaponía' },
  { href: '#granjas', label: 'Granjas' },
  { href: '#productos', label: 'Productos' },
  { href: '#sobre', label: 'Sobre CAY' },
  { href: '#certificaciones', label: 'Certificaciones' },
  { href: '#alianzas', label: 'Alianzas' },
  { href: '#encuentranos', label: 'Encuéntranos' },
  { href: '#blog', label: 'Blog' },
];
---

<nav class="fixed top-0 w-full z-50 bg-surface/95 backdrop-blur-sm border-b border-primary/10">
  <div class="flex justify-between items-center px-5 py-3 max-w-[1280px] mx-auto">
    <a class="flex items-center gap-2 font-headline text-2xl font-bold text-secondary flex-shrink-0" href="/">
      <img alt="CAY Logo" class="h-11 w-11 object-contain" src="/images/cay-logo.png" />
      <span>CAY</span>
    </a>

    <div class="hidden lg:flex gap-4 xl:gap-6 items-center font-body text-[13px] xl:text-sm">
      {
        links.map((link) => (
          <a
            class="text-onSurface font-medium hover:text-primary transition-colors duration-200 whitespace-nowrap"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href="#contacto"
        class="hidden md:inline-flex bg-primary text-white px-5 py-2 rounded-full font-bold text-sm hover:bg-primary/90 active:scale-95 transition-all whitespace-nowrap"
      >
        Contáctanos
      </a>

      <button class="lg:hidden text-onSurface" aria-label="Abrir menú">
        <span class="material-symbols-outlined text-3xl">menu</span>
      </button>
    </div>
  </div>
</nav>
