---
const socials = [
  { name: 'Instagram', href: '#', icon: 'photo_camera' },
  { name: 'LinkedIn', href: '#', icon: 'work' },
  { name: 'TikTok', href: '#', icon: 'music_video' },
];

const alianzas = ['Bofish', 'Aquaponic Events', 'Red Sibiolat'];
const certs = ['USDA Organic', 'Rainforest Alliance', 'CESAJ', 'ISO 22000'];
---

<footer class="bg-secondary text-surface">
  <!-- Bandas de Alianzas + Certificaciones (badges visuales) -->
  <div class="border-b border-white/10">
    <div class="max-w-[1200px] mx-auto px-6 py-10 grid md:grid-cols-2 gap-8">
      <div>
        <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">Alianzas</h4>
        <div class="flex flex-wrap gap-2">
          {alianzas.map((a) => (
            <span class="inline-flex items-center gap-1.5 bg-white/10 border border-primary/30 text-surface text-xs font-bold px-3 py-1.5 rounded-full">
              <span class="material-symbols-outlined text-primary text-sm">handshake</span>
              {a}
            </span>
          ))}
        </div>
      </div>
      <div>
        <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">Certificaciones</h4>
        <div class="flex flex-wrap gap-2">
          {certs.map((c) => (
            <span class="inline-flex items-center gap-1.5 bg-white/10 border border-primary/30 text-surface text-xs font-bold px-3 py-1.5 rounded-full">
              <span class="material-symbols-outlined text-primary text-sm">verified</span>
              {c}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Brand + contacto + redes -->
  <div class="max-w-[1200px] mx-auto px-6 py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <img src="/images/cay-logo.png" alt="CAY Logo" class="h-12 w-12 object-contain" />
        <div>
          <div class="font-headline text-2xl font-bold leading-none">CAY</div>
          <div class="text-primary text-xs font-bold uppercase tracking-wider mt-1">El futuro se cultiva hoy</div>
        </div>
      </div>
    </div>

    <div>
      <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary mb-3">Contacto</h4>
      <ul class="space-y-1.5 font-body text-sm">
        <li class="text-surface/80">México</li>
        <li><a href="mailto:info@cay.mx" class="text-surface/80 hover:text-primary transition-colors">info@cay.mx</a></li>
        <li><a href="tel:+520000000000" class="text-surface/80 hover:text-primary transition-colors">+52 XX XXX XXXX</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-headline text-xs font-bold uppercase tracking-[0.2em] text-primary mb-3">Síguenos</h4>
      <div class="flex gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.name}
              class="w-9 h-9 bg-white/10 hover:bg-primary hover:text-secondary rounded-full flex items-center justify-center transition-colors"
            >
              <span class="material-symbols-outlined text-lg">{s.icon}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-[1200px] mx-auto px-6 py-4 text-center text-surface/60 font-body text-xs">
      © {new Date().getFullYear()} CAY
    </div>
  </div>
</footer>
