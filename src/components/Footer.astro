---
const sections = [
  {
    title: 'Contacto',
    items: [
      { label: 'Guadalajara, México' },
      { label: 'info@cay.mx', href: 'mailto:info@cay.mx' },
      { label: '+52 33 0000 0000', href: 'tel:+523300000000' },
    ],
  },
  {
    title: 'Sitio',
    items: [
      { label: 'Inicio', href: '#inicio' },
      { label: 'Qué es la acuaponía', href: '#que-es' },
      { label: 'Granjas', href: '#granjas' },
      { label: 'Productos', href: '#productos' },
      { label: 'Sobre CAY', href: '#sobre' },
      { label: 'Encuéntranos', href: '#encuentranos' },
    ],
  },
  {
    title: 'Recursos',
    items: [
      { label: 'Galería', href: '#galeria' },
      { label: 'Blog', href: '#blog' },
      { label: 'Privacidad', href: '/privacidad' },
      { label: 'Términos', href: '/terminos' },
    ],
  },
];

const socials = [
  { name: 'Instagram', href: '#', icon: 'photo_camera' },
  { name: 'Facebook', href: '#', icon: 'thumb_up' },
  { name: 'TikTok', href: '#', icon: 'music_video' },
  { name: 'YouTube', href: '#', icon: 'smart_display' },
  { name: 'LinkedIn', href: '#', icon: 'work' },
];
---

<footer class="relative bg-secondary text-surface overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: url(&quot;data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 80'%3E%3Cpath d='M30 5 Q 8 20, 8 50 Q 8 70, 30 75 Q 52 70, 52 50 Q 52 20, 30 5 Z' fill='%239DC41B'/%3E%3C/svg%3E&quot;); background-size: 200px 260px; opacity: 0.06;">
  </div>

  <div class="relative max-w-[1200px] mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="md:col-span-1 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <img src="/images/cay-logo.jpg" alt="CAY Logo" class="h-12 w-12 object-contain rounded-lg bg-white/10 p-1" />
        <span class="font-headline text-2xl font-bold">CAY</span>
      </div>
      <p class="font-headline text-lg text-primary">Acuaponía mexicana</p>
      <p class="text-sm text-surface/70 max-w-xs leading-relaxed">
        De México al mundo. Cultivamos vida mediante el círculo virtuoso del agua, los peces y la tierra
      </p>

      <div class="flex gap-3 mt-4">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.name}
              class="w-10 h-10 bg-white/10 hover:bg-primary hover:text-secondary rounded-full flex items-center justify-center transition-colors"
            >
              <span class="material-symbols-outlined text-xl">{s.icon}</span>
            </a>
          ))
        }
      </div>
    </div>

    {
      sections.map((section) => (
        <div>
          <h4 class="font-headline text-lg mb-4 text-primary">{section.title}</h4>
          <ul class="space-y-2 font-body text-sm">
            {section.items.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} class="text-surface/80 hover:text-primary transition-colors">
                    {item.label}
                  </a>
                ) : (
                  <span class="text-surface/80">{item.label}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="relative border-t border-white/10">
    <div class="max-w-[1200px] mx-auto px-6 py-6 text-center text-surface/60 font-body text-sm">
      © {new Date().getFullYear()} CAY Acuaponía. Empresa 100% mexicana · Guadalajara, México
    </div>
  </div>
</footer>
