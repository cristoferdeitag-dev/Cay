---
const sections = [
  {
    title: 'Contacto',
    items: [
      { label: 'Guadalajara, México' },
      { label: 'hola@cay.mx', href: 'mailto:hola@cay.mx' },
      { label: '+52 33 0000 0000', href: 'tel:+523300000000' },
    ],
  },
  {
    title: 'Explora',
    items: [
      { label: 'Granjas', href: '#granjas' },
      { label: 'Cafecitos', href: '#cafecitos' },
      { label: 'Hortalizas', href: '#hortalizas' },
      { label: 'Koi', href: '#koi' },
    ],
  },
  {
    title: 'Servicios',
    items: [
      { label: 'Pescados', href: '#pescados' },
      { label: 'Acuaponía comercial', href: '#proyectos' },
      { label: 'Contacto', href: '#contacto' },
      { label: 'Privacidad', href: '/privacidad' },
    ],
  },
];
---

<footer class="bg-secondary text-surface">
  <div class="max-w-[1200px] mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="md:col-span-1 flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <img src="/images/cay-logo.jpg" alt="CAY Logo" class="h-12 w-12 object-contain rounded-lg bg-white/10 p-1" />
        <span class="font-headline text-2xl font-bold">CAY</span>
      </div>
      <p class="font-headline text-lg text-primary">Acuaponía profesional</p>
      <p class="text-sm text-surface/70 max-w-xs leading-relaxed mt-2">
        Cultivamos vida mediante el círculo virtuoso del agua, los peces y la tierra. Desde Jalisco para todo México.
      </p>
    </div>

    {
      sections.map((section) => (
        <div>
          <h4 class="font-headline text-lg mb-4 text-primary">{section.title}</h4>
          <ul class="space-y-2 font-body text-sm">
            {section.items.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} class="text-surface/80 hover:text-primary transition-colors">
                    {item.label}
                  </a>
                ) : (
                  <span class="text-surface/80">{item.label}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-[1200px] mx-auto px-6 py-6 text-center text-surface/60 font-body text-sm">
      © {new Date().getFullYear()} CAY Acuaponía Profesional. Guadalajara, México.
    </div>
  </div>
</footer>
