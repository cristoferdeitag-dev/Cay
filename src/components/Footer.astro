---
const socials = [
  { name: 'Instagram', href: '#', icon: 'photo_camera' },
  { name: 'Facebook', href: '#', icon: 'thumb_up' },
  { name: 'TikTok', href: '#', icon: 'music_video' },
  { name: 'YouTube', href: '#', icon: 'smart_display' },
];
---

<footer class="bg-secondary text-surface">
  <div class="max-w-[1200px] mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
    <!-- Brand block -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <img src="/images/cay-logo.png" alt="CAY Logo" class="h-14 w-14 object-contain" />
        <div>
          <div class="font-headline text-2xl font-bold leading-none">CAY</div>
          <div class="text-primary text-xs font-bold uppercase tracking-wider mt-1">Acuaponía mexicana</div>
        </div>
      </div>
    </div>

    <!-- Contacto -->
    <div>
      <h4 class="font-headline text-sm font-bold uppercase tracking-wider text-primary mb-3">Contacto</h4>
      <ul class="space-y-1.5 font-body text-sm">
        <li class="text-surface/80">Guadalajara, México</li>
        <li><a href="mailto:info@cay.mx" class="text-surface/80 hover:text-primary transition-colors">info@cay.mx</a></li>
        <li><a href="tel:+523300000000" class="text-surface/80 hover:text-primary transition-colors">+52 33 0000 0000</a></li>
      </ul>
    </div>

    <!-- Redes sociales -->
    <div>
      <h4 class="font-headline text-sm font-bold uppercase tracking-wider text-primary mb-3">Síguenos</h4>
      <div class="flex gap-2">
        {
          socials.map((s) => (
            <a
              href={s.href}
              aria-label={s.name}
              class="w-9 h-9 bg-white/10 hover:bg-primary hover:text-secondary rounded-full flex items-center justify-center transition-colors"
            >
              <span class="material-symbols-outlined text-lg">{s.icon}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-[1200px] mx-auto px-6 py-4 text-center text-surface/60 font-body text-xs">
      © {new Date().getFullYear()} CAY Acuaponía · 100% mexicana · Guadalajara
    </div>
  </div>
</footer>
