    detail: 'Uso responsable y recirculación eficiente del agua',
    color: '#26BDE2',
    iconPath: 'M50 14 Q35 30, 32 46 Q30 60, 50 62 Q70 60, 68 46 Q65 30, 50 14 Z',
  },
