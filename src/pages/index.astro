    detail: 'Granjas comerciales de gran escala y formación profesional en acuaponía',
    icon: 'handshake',
  },
  {
    name: 'Aquaponic Events',
    detail: 'Eventos, congresos y cursos para llevar la acuaponía a más mexicanos',
    icon: 'event',
  },
  {
    name: 'Red Sibiolat',
    detail: 'Red latinoamericana de simbiosis biológica para el cultivo regenerativo',
    icon: 'hub',
  },
];

const estados = [
  { name: 'Jalisco', subtitle: 'Granja central · Guadalajara' },
  { name: 'Puebla', subtitle: 'Sierra Norte' },
  { name: 'Tlaxcala', subtitle: 'Altiplano' },
  { name: 'Hidalgo', subtitle: 'Real del Monte' },
  { name: 'Oaxaca', subtitle: 'Valles Centrales' },
