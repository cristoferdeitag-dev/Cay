---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';

const productos = [
  {
    id: 'hortalizas',
    title: 'Hortalizas',
    sub: 'Cosecha del día, sin pesticidas',
    items: ['Lechuga italiana', 'Lechuga sangría', 'Lechuga orejona', 'Apio', 'Albahaca', 'Espinaca'],
    image: '/images/hortalizas.jpg',
    icon: 'eco',
  },
  {
    id: 'peces',
    title: 'Peces',
    sub: 'Consumo y ornato',
    items: ['Tilapia gris', 'Tilapia naranja', 'Carpas koi', 'Guppys'],
    image: '/images/koi.jpg',
    icon: 'phishing',
  },
];

const cycle = [
  {
    step: '01',
    icon: 'water_drop',
    title: 'Acuicultura',
    description: 'Criamos peces en agua rica en nutrientes naturales',
  },
  {
    step: '02',
    icon: 'science',
    title: 'Biofiltración',
    description: 'Bacterias benéficas transforman los residuos en nutrientes para las plantas',
  },
  {
    step: '03',
    icon: 'eco',
    title: 'Hidroponía',
    description: 'Las plantas absorben nutrientes y limpian el agua del sistema',
  },
];

const benefits = [
  { stat: '90%', label: 'Menos agua', detail: 'que la agricultura tradicional' },
  { stat: '4×', label: 'Más rendimiento', detail: 'por metro cuadrado' },
  { stat: '0', label: 'Pesticidas', detail: 'el agua no permitiría a los peces' },
  { stat: '0', label: 'Erosión', detail: 'el cultivo no toca tierra' },
];

const problemas = [
  'Pobreza',
  'Hambruna',
  'Sobrepoblación',
  'Falta de educación',
  'Problemas de salud',
  'Desempleo',
  'Desigualdad económica',
  'Falta de agua potable',
  'Uso irresponsable del agua',
  'Sobreexplotación de recursos',
  'Problemas medioambientales',
  'Maltrato animal',
];

const granjas = [
  {
    type: 'Granjas comerciales',
    description: 'Producción a escala para abastecer mercados, restaurantes y supermercados',
    subcats: [
      { name: 'Productores', detail: 'Volumen industrial de hortalizas y proteína' },
      { name: 'Farm-to-table', detail: 'Cosecha del día hacia chefs y consumidores directos' },
    ],
    icon: 'agriculture',
  },
  {
    type: 'Granjas agroturísticas',
    description: 'Espacios abiertos al público para vivir la acuaponía de cerca',
    subcats: [
      { name: 'Visitas y tours', detail: 'Experiencia educativa para familias y escuelas' },
      { name: 'Granjas caseras', detail: 'Sistemas residenciales que diseñamos y armamos contigo' },
    ],
    icon: 'tour',
  },
];

// Alianzas (antes "Red de colaboración") — agregada Red Sibiolat
const alianzas = [
  {
    name: 'Bofish',
    detail: 'Granjas comerciales de gran escala y formación profesional en acuaponía',
    icon: 'handshake',
  },
  {
    name: 'Aquaponic Events',
    detail: 'Eventos, congresos y cursos para llevar la acuaponía a más mexicanos',
    icon: 'event',
  },
  {
    name: 'Red Sibiolat',
    detail: 'Red latinoamericana de simbiosis biológica para el cultivo regenerativo',
    icon: 'hub',
  },
];

const estados = [
  { name: 'Jalisco', subtitle: 'Granja central · Guadalajara' },
  { name: 'Puebla', subtitle: 'Sierra Norte' },
  { name: 'Tlaxcala', subtitle: 'Altiplano' },
  { name: 'Hidalgo', subtitle: 'Real del Monte' },
  { name: 'Oaxaca', subtitle: 'Valles Centrales' },
];

const puntosVentaList = [
  { name: 'Walmart', icon: 'storefront', detail: 'Tiendas seleccionadas' },
  { name: 'Chedraui Selecto', icon: 'storefront', detail: 'Tiendas seleccionadas' },
  { name: 'City Market', icon: 'storefront', detail: 'Tiendas seleccionadas' },
  { name: 'Fruto Café', icon: 'local_cafe', detail: 'Farm-to-table partner' },
  { name: 'En la granja', icon: 'agriculture', detail: 'Venta directa al productor' },
  { name: 'Restaurantes', icon: 'restaurant', detail: 'Aliados farm-to-table' },
];

const mvv = [
  {
    title: 'Propuesta de valor',
    body: 'Alimentos acuapónicos sostenibles para una vida más saludable',
    icon: 'star',
  },
  {
    title: 'Misión',
    body: 'Revolucionar la producción de alimentos a través de la acuaponía',
    icon: 'flag',
  },
  {
    title: 'Visión',
    body: 'Ser líderes en innovación agroalimentaria sostenible en México',
    icon: 'visibility',
  },
];

const valores = ['Humanidad', 'Integridad', 'Calidad', 'Innovación', 'Compromiso'];

// ODS oficiales ONU — imágenes recortadas del banner oficial que mandó Asaí
const ods = [
  { num: 2, image: '/images/ods/ods-2.jpg', alt: 'ODS 2 Hambre cero' },
  { num: 3, image: '/images/ods/ods-3.jpg', alt: 'ODS 3 Salud y bienestar' },
  { num: 6, image: '/images/ods/ods-6.jpg', alt: 'ODS 6 Agua limpia y saneamiento' },
  { num: 7, image: '/images/ods/ods-7.jpg', alt: 'ODS 7 Energía asequible y no contaminante' },
  { num: 8, image: '/images/ods/ods-8.jpg', alt: 'ODS 8 Trabajo decente y crecimiento económico' },
  { num: 9, image: '/images/ods/ods-9.jpg', alt: 'ODS 9 Industria, innovación e infraestructura' },
  { num: 10, image: '/images/ods/ods-10.jpg', alt: 'ODS 10 Reducción de las desigualdades' },
  { num: 11, image: '/images/ods/ods-11.jpg', alt: 'ODS 11 Ciudades y comunidades sostenibles' },
  { num: 12, image: '/images/ods/ods-12.jpg', alt: 'ODS 12 Producción y consumo responsables' },
  { num: 13, image: '/images/ods/ods-13.jpg', alt: 'ODS 13 Acción por el clima' },
  { num: 14, image: '/images/ods/ods-14.jpg', alt: 'ODS 14 Vida submarina' },
  { num: 15, image: '/images/ods/ods-15.jpg', alt: 'ODS 15 Vida de ecosistemas terrestres' },
];

const certs = [
  { name: 'Hecho en México', label: 'Producción nacional' },
  { name: 'USDA Organic', label: 'Orgánico certificado' },
  { name: 'CESAJ', label: 'Calidad acuícola Jalisco' },
  { name: 'Rainforest Alliance', label: 'Sostenibilidad' },
  { name: 'ISO', label: 'Sistemas de gestión' },
];


const founders = [
  { name: 'Cristofer De Ita', role: 'Founder', initials: 'CD' },
  { name: 'Asaí López', role: 'Founder', initials: 'AL' },
];

const galleryShots = [
  '/images/hero-granja.jpg',
  '/images/hortalizas.jpg',
  '/images/koi.jpg',
  '/images/proyectos.jpg',
];

const blogTeasers = [
  {
    tag: 'Acuaponía 101',
    title: 'Lo que nadie te cuenta del agua que comes',
    excerpt: 'Por qué el ciclo cerrado cambia las reglas de lo que llamamos "fresco" en México',
  },
  {
    tag: 'Productor',
    title: 'Cómo planeamos una cosecha de 1,000 lechugas semanales',
    excerpt: 'Detrás de la operación: variedades, densidad, temperatura del agua y el ojo del operario',
  },
  {
    tag: 'Historia',
    title: 'Chinampas: la acuaponía que ya existía',
    excerpt: 'Lo que aprendieron los aztecas en Xochimilco y que hoy reaplicamos con tecnología',
  },
];

// (Patterns SVG removidos — solo usar el logo real como elemento de marca)
---

<Layout>
  <TopNav />

  <main>
    <!-- HERO -->
    <section id="inicio" class="relative overflow-hidden pt-32 pb-24 md:pt-40 md:pb-32 bg-surface">
      <div class="hidden md:block absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>
      <div class="hidden md:block absolute top-1/2 -left-40 w-[500px] h-[500px] rounded-full bg-secondary/10 blur-3xl pointer-events-none"></div>

      <div class="relative max-w-[1200px] mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <p class="text-sm text-primary font-bold uppercase tracking-[0.2em]">
            CAY — Cultivando el futuro
          </p>
          <h1 class="font-headline text-5xl md:text-6xl lg:text-[72px] leading-[0.98] text-secondary font-bold">
            El futuro de la<br />
            agricultura es<br />
            <span class="text-primary">acuapónico</span>
          </h1>
          <p class="text-onSurface-variant text-lg max-w-md font-body leading-relaxed">
            Producción inteligente de alimentos con menor impacto ambiental
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="#que-es"
              class="bg-primary text-white px-8 py-4 rounded-full font-bold hover:bg-primary/90 transition-all shadow-lg shadow-primary/25 hover:-translate-y-0.5"
            >
              Cómo funciona
            </a>
            <a
              href="#productos"
              class="border-2 border-secondary text-secondary px-8 py-4 rounded-full font-bold hover:bg-secondary/5 transition-colors"
            >
              Ver productos
            </a>
          </div>
        </div>
        <div class="relative">
          <div class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl shadow-secondary/20">
            <img src="/images/hero-granja.jpg" alt="Granja acuapónica CAY" class="w-full h-full object-cover" loading="eager" />
          </div>
        </div>
      </div>
    </section>

    <!-- QUÉ ES LA ACUAPONÍA -->
    <section id="que-es" class="relative bg-primary/95 text-white py-24 md:py-32 overflow-hidden">
      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-secondary mb-4">El sistema</p>
          <h2 class="font-headline text-5xl md:text-6xl font-bold leading-tight mb-8">
            Cómo funciona
          </h2>
          <div class="max-w-3xl mx-auto text-white/95 text-lg font-body leading-relaxed space-y-4 text-justify mb-8">
            <p>
              La acuaponía integra <strong>peces, agua y plantas</strong> en un sistema circular y sostenible.
            </p>
            <p>
              Los peces generan nutrientes para las plantas, mientras las plantas filtran y limpian el agua que
              regresa al ecosistema.
            </p>
            <p>
              Así producimos alimentos frescos con menos desperdicio y menor impacto ambiental.
            </p>
          </div>
          <p class="text-primary font-headline text-2xl md:text-3xl font-bold italic">
            Una simbiosis perfecta
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 relative">
          <div class="hidden md:block absolute top-12 left-[16%] right-[16%] h-1 bg-white/20 -z-10"></div>
          {
            cycle.map((step) => (
              <div class="bg-white text-secondary p-8 rounded-3xl shadow-xl shadow-secondary/10 relative hover:-translate-y-1 transition-transform duration-300">
                <div class="w-16 h-16 bg-secondary text-white rounded-full flex items-center justify-center font-bold text-xl absolute -top-8 left-1/2 -translate-x-1/2">
                  {step.step}
                </div>
                <span class="material-symbols-outlined text-5xl text-primary mt-6 mb-4 block">{step.icon}</span>
                <h3 class="font-headline text-2xl font-bold mb-3">{step.title}</h3>
                <p class="text-onSurface-variant text-base font-body leading-relaxed">{step.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- POR QUÉ ACUAPONÍA (vs tradicional/hidroponía) -->
    <section class="relative bg-surface py-24 md:py-32 overflow-hidden">
      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Por qué acuaponía</p>
          <h2 class="font-headline text-5xl md:text-6xl text-secondary font-bold leading-tight mb-6">
            Mejor que la agricultura<br />tradicional y la hidroponía
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16">
          {
            benefits.map((b) => (
              <div class="text-center p-8 bg-white rounded-3xl shadow-lg shadow-secondary/5 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
                <div class="font-headline text-5xl md:text-6xl text-primary font-bold mb-2">{b.stat}</div>
                <div class="font-headline text-lg text-secondary font-bold mb-1">{b.label}</div>
                <div class="text-sm text-onSurface-variant">{b.detail}</div>
              </div>
            ))
          }
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-secondary text-white p-8 rounded-3xl">
            <h3 class="font-headline text-2xl font-bold mb-4">Y además</h3>
            <ul class="space-y-3 font-body text-base">
              <li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Sin erosión del suelo</li>
              <li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Producción todo el año</li>
              <li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Mejor sabor, textura y duración</li>
              <li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Productos 100% orgánicos</li>
              <li class="flex gap-3"><span class="material-symbols-outlined text-primary">check_circle</span>Eco-friendly por diseño</li>
            </ul>
          </div>
          <div class="bg-primary text-secondary p-8 rounded-3xl">
            <h3 class="font-headline text-2xl font-bold mb-4">Lo que resuelve</h3>
            <ul class="space-y-3 font-body text-base">
              <li class="flex gap-3"><span class="material-symbols-outlined">water_drop</span>Escasez creciente de agua</li>
              <li class="flex gap-3"><span class="material-symbols-outlined">eco</span>Suelos cansados y desnutridos</li>
              <li class="flex gap-3"><span class="material-symbols-outlined">no_food</span>Dependencia de pesticidas</li>
              <li class="flex gap-3"><span class="material-symbols-outlined">local_shipping</span>Cadenas de frío kilométricas</li>
              <li class="flex gap-3"><span class="material-symbols-outlined">restaurant</span>Alimentos sin trazabilidad real</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- GRANJAS HECHAS A LA MEDIDA -->
    <section id="granjas" class="relative bg-secondary text-white py-24 md:py-32 overflow-hidden">
      <div class="hidden md:block absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>

      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Granjas</p>
          <h2 class="font-headline text-5xl md:text-6xl font-bold leading-tight mb-6">
            Granjas hechas<br /><span class="text-primary">a la medida</span>
          </h2>
          <p class="max-w-2xl mx-auto text-white/85 text-base">
            Diseñamos y construimos granjas acuapónicas según el tipo de proyecto — de la operación comercial al
            espacio agroturístico, pasando por sistemas residenciales
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-16">
          {
            granjas.map((g) => (
              <div class="bg-white text-secondary p-8 md:p-10 rounded-3xl shadow-xl shadow-black/20 hover:-translate-y-1 transition-transform duration-300">
                <div class="w-14 h-14 bg-primary/15 text-primary rounded-2xl flex items-center justify-center mb-6">
                  <span class="material-symbols-outlined text-3xl">{g.icon}</span>
                </div>
                <h3 class="font-headline text-3xl font-bold mb-3">{g.type}</h3>
                <p class="text-onSurface-variant font-body mb-6">{g.description}</p>
                <ul class="space-y-4">
                  {g.subcats.map((sc) => (
                    <li class="border-l-4 border-primary pl-4">
                      <div class="font-headline text-lg font-bold">{sc.name}</div>
                      <div class="text-sm text-onSurface-variant">{sc.detail}</div>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Estados donde están las granjas -->
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-3xl p-8 md:p-10 mb-12">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-4 text-center">
            Hoy operamos en cinco estados
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            {estados.map((e) => (
              <div class="bg-white/10 border border-primary/30 rounded-2xl px-5 py-3 text-center">
                <div class="flex items-center gap-2 justify-center">
                  <span class="material-symbols-outlined text-primary text-base">place</span>
                  <span class="font-headline font-bold text-white">{e.name}</span>
                </div>
                <div class="text-xs text-white/70 mt-1">{e.subtitle}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA Hablemos integrado -->
        <div class="bg-primary text-secondary rounded-3xl p-10 md:p-12 text-center max-w-3xl mx-auto shadow-2xl shadow-primary/20">
          <h3 class="font-headline text-3xl md:text-4xl font-bold mb-3 leading-tight">
            ¿Quieres construir tu propia granja?
          </h3>
          <p class="text-secondary/85 text-base md:text-lg mb-8 font-body">
            Hablemos de tu proyecto — desde el primer sistema casero hasta una operación comercial completa
          </p>
          <a
            href="mailto:info@cay.mx"
            class="inline-block bg-secondary text-white px-10 py-4 rounded-full font-bold text-base hover:bg-secondary/90 shadow-lg shadow-secondary/30 hover:-translate-y-0.5 transition-all"
          >
            Hablemos de tu proyecto
          </a>
        </div>
      </div>
    </section>

    <!-- PRODUCTOS -->
    <section id="productos" class="relative py-24 md:py-32 bg-surface overflow-hidden">
      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Nuestros productos</p>
          <h2 class="font-headline text-5xl md:text-6xl text-secondary font-bold leading-tight">
            De la granja<br />a tu mesa
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {
            productos.map((p) => (
              <article
                id={p.id}
                class="group relative bg-white rounded-3xl overflow-hidden shadow-lg shadow-secondary/5 hover:shadow-2xl hover:shadow-primary/15 hover:-translate-y-2 transition-all duration-300"
              >
                <div class="relative aspect-[4/3] overflow-hidden">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                  <div class="absolute top-4 left-4 w-12 h-12 bg-white/95 rounded-full flex items-center justify-center backdrop-blur-sm">
                    <span class="material-symbols-outlined text-2xl text-primary">{p.icon}</span>
                  </div>
                </div>
                <div class="p-8">
                  <h3 class="font-headline text-3xl font-bold text-secondary mb-1">{p.title}</h3>
                  <p class="text-primary text-sm font-bold uppercase tracking-wider mb-4">{p.sub}</p>
                  <div class="flex flex-wrap gap-2 mb-6">
                    {p.items.map((it) => (
                      <span class="inline-block bg-primary/10 text-secondary text-xs font-semibold px-3 py-1.5 rounded-full">
                        {it}
                      </span>
                    ))}
                  </div>
                  <a
                    href="#contacto"
                    class="inline-flex items-center gap-1 text-secondary font-bold hover:gap-2 transition-all"
                  >
                    Pedir cotización
                    <span class="material-symbols-outlined">arrow_forward</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ENCUÉNTRANOS -->
    <section id="encuentranos" class="relative py-24 md:py-32 bg-primary/10 overflow-hidden">
      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Encuéntranos</p>
          <h2 class="font-headline text-5xl md:text-6xl text-secondary font-bold leading-tight">
            Dónde conseguir<br />nuestros productos
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          {
            puntosVentaList.map((p) => (
              <div class="bg-white p-5 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
                <div class="w-12 h-12 bg-primary/15 text-primary rounded-full flex items-center justify-center mx-auto mb-3">
                  <span class="material-symbols-outlined text-xl">{p.icon}</span>
                </div>
                <div class="font-headline text-base text-secondary font-bold mb-1 leading-tight">{p.name}</div>
                <div class="text-[11px] text-onSurface-variant">{p.detail}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- HISTORIA (densa, 1 pantalla, sin scroll en desktop) -->
    <section id="historia" class="relative py-20 md:py-24 bg-secondary text-white overflow-hidden">
      <div class="hidden md:block absolute -bottom-32 -right-32 w-[400px] h-[400px] rounded-full bg-primary/15 blur-3xl pointer-events-none"></div>

      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="grid md:grid-cols-12 gap-8 items-center">
          <!-- Imagen (5 cols) -->
          <div class="md:col-span-5">
            <div class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-2xl shadow-black/30">
              <img src="/images/cafecito-fruto.jpg" alt="Granjas CAY" class="w-full h-full object-cover" loading="lazy" />
            </div>
          </div>

          <!-- Texto + MVV + Valores (7 cols) -->
          <div class="md:col-span-7 space-y-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Historia · 100% mexicana</p>
              <h2 class="font-headline text-3xl md:text-4xl font-bold leading-[1.1] mb-3">
                Tecnología inspirada<br />en nuestras raíces
              </h2>
              <div class="text-white/90 text-sm md:text-base leading-relaxed font-body space-y-2 text-justify">
                <p>
                  Las antiguas <strong>chinampas mesoamericanas</strong> demostraron que era posible producir
                  alimentos en equilibrio con la naturaleza.
                </p>
                <p>
                  En CAY transformamos esa inspiración en sistemas acuapónicos modernos que unen innovación,
                  sostenibilidad y producción inteligente.
                </p>
                <p>
                  Construimos el futuro de la alimentación con tecnología, agua y manos mexicanas.
                </p>
              </div>
            </div>

            <!-- MVV compactos como 3 columnas estrechas -->
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Lo que nos mueve</p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                {mvv.map((m) => (
                  <div class="bg-white/10 border border-white/15 rounded-xl p-3">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="material-symbols-outlined text-primary text-base">{m.icon}</span>
                      <h4 class="font-headline text-sm font-bold">{m.title}</h4>
                    </div>
                    <p class="text-xs text-white/80 leading-snug font-body">{m.body}</p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Valores chips + Founders en una sola fila -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Valores</p>
                <div class="flex flex-wrap gap-1.5">
                  {valores.map((v) => (
                    <span class="inline-block bg-white/10 border border-primary/40 text-primary text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full">
                      {v}
                    </span>
                  ))}
                </div>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-2">Fundadores</p>
                <div class="space-y-1.5">
                  {founders.map((f) => (
                    <div class="flex items-center gap-2 bg-white/10 border border-white/15 rounded-xl p-2">
                      <div class="w-7 h-7 bg-primary text-secondary rounded-full flex items-center justify-center font-headline font-bold text-[10px] flex-shrink-0">
                        {f.initials}
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="font-headline text-xs font-bold leading-tight truncate">{f.name}</div>
                        <div class="text-primary text-[9px] font-bold uppercase tracking-wider">{f.role}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CERTIFICACIONES -->
    <section id="certificaciones" class="relative py-20 bg-white overflow-hidden">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Certificaciones</p>
          <h2 class="font-headline text-3xl md:text-4xl text-secondary font-bold">Producimos con respaldo</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
          {
            certs.map((c) => (
              <div class="border border-primary/20 rounded-2xl p-6 text-center hover:border-primary hover:bg-primary/5 transition-all">
                <div class="w-12 h-12 mx-auto mb-3 bg-primary/15 text-primary rounded-full flex items-center justify-center">
                  <span class="material-symbols-outlined">verified</span>
                </div>
                <div class="font-headline font-bold text-secondary text-sm">{c.name}</div>
                <div class="text-xs text-onSurface-variant mt-1">{c.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ALIANZAS -->
    <section id="alianzas" class="relative py-20 md:py-24 bg-secondary/10 overflow-hidden">
      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Alianzas</p>
          <h2 class="font-headline text-3xl md:text-5xl text-secondary font-bold leading-tight mb-4">
            No caminamos solos
          </h2>
          <p class="max-w-2xl mx-auto text-onSurface-variant text-base">
            Construimos junto a otras empresas mexicanas y latinoamericanas que comparten la misma visión: alimentar
            sin comprometer al planeta
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            alianzas.map((a) => (
              <div class="bg-white rounded-3xl p-8 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center">
                <div class="w-16 h-16 bg-primary/15 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="material-symbols-outlined text-3xl">{a.icon}</span>
                </div>
                <h3 class="font-headline text-2xl text-secondary font-bold mb-2">{a.name}</h3>
                <p class="text-sm text-onSurface-variant">{a.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- GRANITO DE ARENA + ODS (fusionados) -->
    <section id="por-que" class="relative bg-secondary text-white py-24 md:py-32 overflow-hidden">
      <div class="hidden md:block absolute -top-32 -left-32 w-[500px] h-[500px] rounded-full bg-primary/20 blur-3xl pointer-events-none"></div>

      <div class="relative max-w-[1200px] mx-auto px-6 mb-20">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-4">Nuestro porqué</p>
          <h2 class="font-headline text-5xl md:text-6xl font-bold leading-[1.05] mb-10">
            Ponemos nuestro<br /><span class="text-primary">granito de arena</span>
          </h2>
          <p class="text-white/90 text-lg leading-relaxed mb-6 font-body">
            En CAY creemos firmemente que en México y en el mundo necesitamos más soluciones y alternativas para los
            problemas que enfrentamos día con día
          </p>
        </div>

        <div class="flex flex-wrap gap-3 my-12 max-w-4xl">
          {
            problemas.map((p) => (
              <span class="inline-block bg-white/10 border border-primary/30 text-primary text-sm font-semibold px-4 py-2 rounded-full">
                {p}
              </span>
            ))
          }
        </div>

        <div class="max-w-3xl">
          <p class="text-white/90 text-lg leading-relaxed mb-6 font-body">
            Todos podemos aportar en la medida de lo posible — <strong>por nosotros, por ellos, por todos</strong>.
            Nuestro planeta nos necesita. Seamos más conscientes, más <strong class="text-primary">humanos</strong>
          </p>
          <p class="text-white/90 text-lg leading-relaxed font-body">
            En CAY queremos hacer la diferencia por medio de la acuaponía, alineando nuestro trabajo con la Agenda 2030
            de las Naciones Unidas
          </p>
        </div>
      </div>

      <!-- ODS dentro de la misma sección -->
      <div id="ods" class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-10">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Compromiso con la ONU</p>
          <h3 class="font-headline text-3xl md:text-5xl font-bold mb-4 leading-tight">
            Contribuimos a 12 objetivos<br />de desarrollo sostenible
          </h3>
        </div>

        <p class="text-center text-sm font-bold uppercase tracking-wider text-primary mb-8">
          Los 12 que CAY trabaja activamente
        </p>

        <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 md:gap-4">
          {
            ods.map((o) => (
              <div class="aspect-square overflow-hidden rounded-lg shadow-md hover:scale-105 hover:shadow-2xl transition-all duration-300">
                <img src={o.image} alt={o.alt} class="w-full h-full object-cover" loading="lazy" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- GALERÍA -->
    <section id="galeria" class="relative py-24 md:py-32 bg-secondary text-white overflow-hidden">
      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Galería</p>
          <h2 class="font-headline text-3xl md:text-5xl font-bold">
            La granja en imágenes y video
          </h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {
            galleryShots.map((src, i) => (
              <div class="relative aspect-square overflow-hidden rounded-2xl group cursor-pointer shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-300">
                <img src={src} alt={`Galería ${i + 1}`} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-secondary/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- BLOG TEASER -->
    <section id="blog" class="relative py-24 md:py-32 bg-surface overflow-hidden">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="flex flex-wrap justify-between items-end mb-12 gap-4">
          <div>
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-3">Blog</p>
            <h2 class="font-headline text-4xl md:text-5xl text-secondary font-bold leading-tight">
              Aprende sobre<br />acuaponía y agua
            </h2>
          </div>
          <a href="#" class="text-secondary font-bold hover:text-primary transition-colors">Ver todo →</a>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {
            blogTeasers.map((post, i) => (
              <article class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 cursor-pointer group">
                <div class="aspect-[16/10] overflow-hidden">
                  <img src={galleryShots[i % galleryShots.length]} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-6">
                  <span class="inline-block bg-primary/15 text-primary text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3">{post.tag}</span>
                  <h3 class="font-headline text-xl font-bold text-secondary mb-2 leading-tight">{post.title}</h3>
                  <p class="text-sm text-onSurface-variant font-body leading-relaxed">{post.excerpt}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section id="contacto" class="relative bg-primary py-20 md:py-24 text-center overflow-hidden">
      <div class="relative max-w-2xl mx-auto px-6">
        <h2 class="font-headline text-5xl md:text-6xl text-secondary font-bold mb-6 leading-tight">
          Hablemos de tu<br />proyecto en acuaponía
        </h2>
        <p class="text-secondary/85 text-lg mb-10 font-body">
          Productos, granjas a la medida, visitas o asesoría — cuéntanos qué necesitas
        </p>
        <a
          href="mailto:info@cay.mx"
          class="inline-block bg-secondary text-white px-12 py-5 rounded-full font-bold text-lg hover:bg-secondary/90 shadow-2xl shadow-secondary/30 hover:-translate-y-1 transition-all duration-200"
        >
          info@cay.mx
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @keyframes float-slow {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-12px) rotate(4deg); }
  }
  @keyframes float-medium {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-8px) rotate(-3deg); }
  }
  @keyframes swim {
    0%, 100% { transform: translateX(0) translateY(0); }
    50% { transform: translateX(-8px) translateY(-6px); }
  }
  @keyframes wave-anim {
    0% { background-position-x: 0; }
    100% { background-position-x: -400px; }
  }
  .animate-float-slow { animation: float-slow 6s ease-in-out infinite; }
  .animate-float-medium { animation: float-medium 4.5s ease-in-out infinite; }
  .animate-swim { animation: swim 5s ease-in-out infinite; }
  .animate-wave { animation: wave-anim 22s linear infinite; }
</style>
